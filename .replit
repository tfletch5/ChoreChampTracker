modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ChoreChamp App Server"

[[workflows.workflow]]
name = "ChoreChamp App Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=1 npx expo start --web --port 5000"
waitForPort = 5000

[deployment]
run = ["sh", "-c", "npx expo start --web --port 5000"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 19006
externalPort = 3000
